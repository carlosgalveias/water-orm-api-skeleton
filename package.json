{
  "name": "worm_api",
  "version": "1.0.1",
  "description": "",
  "license": "UNLICENSED",
  "author": "Carlos Galveias",
  "type": "commonjs",
  "main": "api/api.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "local": "node api/local.js",
    "test": "set RUNNING_TESTS && node --test",
    "test:coverage": "set RUNNING_TESTS=true && node --test --experimental-test-coverage --test-coverage-include=utils/** --test-coverage-include=controllers/** --test-coverage-include=routers/** --test-coverage-include=api/** --test-coverage-include=models/** --test-coverage-include=config/** --test-coverage-exclude=tests/** --test-coverage-exclude=node_modules/**",
    "test:coverage:html": "set RUNNING_TESTS=true && node --test --experimental-test-coverage --test-coverage-include=utils/** --test-coverage-include=controllers/** --test-coverage-include=routers/** --test-coverage-include=api/** --test-coverage-include=models/** --test-coverage-include=config/** --test-coverage-exclude=tests/** --test-coverage-exclude=node_modules/** > coverage-report.txt",
    "test:watch": "set RUNNING_TESTS=true && node --test --watch",
    "test:unit": "set RUNNING_TESTS=true && node --test tests/unit/**/*.test.js",
    "test:unit:coverage": "set RUNNING_TESTS && node --test --experimental-test-coverage --test-coverage-include=utils/** --test-coverage-include=controllers/** --test-coverage-include=routers/** --test-coverage-include=api/** --test-coverage-include=models/** --test-coverage-include=config/** tests/unit/**/*.test.js",
    "test:integration": "set RUNNING_TESTS && node --test tests/integration/**/*.test.js",
    "test:integration:coverage": "set RUNNING_TESTS && node --test --experimental-test-coverage --test-coverage-include=utils/** --test-coverage-include=controllers/** --test-coverage-include=routers/** --test-coverage-include=api/** --test-coverage-include=models/** --test-coverage-include=config/** tests/integration/**/*.test.js",
    "start": "node api/local.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "object-sizeof": "^2.6.5",
    "pluralize": "^8.0.0",
    "water-orm": "^0.0.7"
  },
  "overrides": {
    "underscore": "1.13.8",
    "lodash": "4.18.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.14.2"
  }
}
